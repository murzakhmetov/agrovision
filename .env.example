# Copy this file to .env (which is gitignored) and fill in your own values.
# Real environment variables take precedence over values in .env.

# Google Gemini API key for ONLINE chat mode. Leave empty to use only the
# offline knowledge base.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated list of origins allowed by CORS. The bundled web app is
# served by the backend itself, so it does not need an entry here.
AGROVISION_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Model class names that count as crops (case-insensitive). Defaults match
# ml_models/weedblaster-cropandweed-yolov8s.pt; every other class is a weed.
# AGROVISION_CROP_CLASSES=Maize,Sugar beet,Soy,Sunflower,Potato,Pea,Bean,Pumpkin,Crop
